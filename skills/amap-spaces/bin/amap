#!/usr/bin/env node
/*
  amap - tiny CLI for AMap (Gaode) Web Service APIs
  Requires env: AMAP_API_KEY
*/

const { argv, env, exit } = process;
const TIMEOUT_MS = Number(env.AMAP_TIMEOUT_MS || 15000);

function usage(code = 0, msg) {
  if (msg) console.error(msg);
  console.error(`
Usage:
  amap poi <keywords> [--city <city>] [--types <types>] [--limit N] [--page P] [--json]
  amap around --lat <lat> --lng <lng> [--keywords <kw>] [--radius M] [--sortrule weight|distance] [--limit N] [--page P] [--json]
  amap details <id> [--json]
  amap route driving --origin <lng,lat> --dest <lng,lat> [--strategy <0..10>] [--avoidpolygons <poly>] [--json]
  amap route walking --origin <lng,lat> --dest <lng,lat> [--json]
  amap geocode <address> [--city <city>] [--json]
  amap regeo --lat <lat> --lng <lng> [--radius M] [--extensions all|base] [--json]

Env:
  AMAP_API_KEY=... (Gaode Web Service API key)
  AMAP_TIMEOUT_MS=15000 (optional request timeout)
`);
  process.exit(code);
}

function getKey() {
  const key = env.AMAP_API_KEY;
  if (!key) usage(2, 'amap: missing api key (set AMAP_API_KEY)');
  return key;
}

function parseArgs(args) {
  const out = { _: [] };
  for (let i = 0; i < args.length; i++) {
    const a = args[i];
    if (!a.startsWith('--')) {
      out._.push(a);
      continue;
    }
    const k = a.slice(2);
    if (k === 'json') { out.json = true; continue; }
    const v = args[i + 1];
    if (v == null || v.startsWith('--')) usage(2, `amap: missing value for --${k}`);
    out[k] = v;
    i++;
  }
  return out;
}

function clampInt(v, dflt, min, max) {
  const n = v == null || v === '' ? dflt : Number(v);
  if (!Number.isFinite(n)) usage(2, `amap: invalid number: ${v}`);
  return Math.min(max, Math.max(min, Math.trunc(n)));
}

function pick(obj, keys) {
  const o = {};
  for (const k of keys) if (obj[k] !== undefined) o[k] = obj[k];
  return o;
}

async function httpGet(url, params) {
  const u = new URL(url);
  for (const [k, v] of Object.entries(params)) {
    if (v === undefined || v === null || v === '') continue;
    u.searchParams.set(k, String(v));
  }
  const res = await fetch(u, { signal: AbortSignal.timeout(TIMEOUT_MS) });
  const text = await res.text();
  let json;
  try { json = JSON.parse(text); } catch { json = { raw: text }; }
  if (!res.ok) {
    const err = new Error(`HTTP ${res.status}`);
    err.detail = json;
    throw err;
  }
  // AMap signals business errors with HTTP 200 + status "0" (e.g. INVALID_USER_KEY, DAILY_QUERY_OVER_LIMIT).
  if (json && json.status === '0') {
    const err = new Error(`AMap error ${json.infocode || ''}: ${json.info || 'unknown'}`);
    err.detail = pick(json, ['status', 'info', 'infocode']);
    throw err;
  }
  return json;
}

function normalizePois(pois) {
  return (pois || []).map(p => ({
    id: p.id,
    name: p.name,
    address: p.address || p.location,
    location: p.location,
    tel: p.tel,
    type: p.type,
    typecode: p.typecode,
    distance: p.distance,
    rating: p.rating,
    cost: p.cost,
    photos: p.photos,
    biz_ext: p.biz_ext,
    cityname: p.cityname,
    adname: p.adname,
  }));
}

function printHumanPoiList(title, data) {
  const pois = data.pois || [];
  console.log(`${title}\nResults: ${pois.length}`);
  for (let i = 0; i < pois.length; i++) {
    const p = pois[i];
    const dist = p.distance ? ` · ${p.distance}m` : '';
    console.log(`${i + 1}. ${p.name}${dist}`);
    console.log(`   ${p.pname || ''}${p.cityname || ''}${p.adname || ''}${p.address ? ' · ' + p.address : ''}`.trim());
    if (p.location) console.log(`   loc: ${p.location}`);
    if (p.tel) console.log(`   tel: ${p.tel}`);
    if (p.type) console.log(`   type: ${p.type}`);
  }
}

async function cmdPoi(rest, flags) {
  const key = getKey();
  const keywords = rest.join(' ').trim();
  if (!keywords) usage(2, 'amap poi: missing <keywords>');

  const limit = clampInt(flags.limit, 10, 1, 25);
  const page = clampInt(flags.page, 1, 1, 100);

  const json = await httpGet('https://restapi.amap.com/v3/place/text', {
    key,
    keywords,
    city: flags.city,
    types: flags.types,
    offset: limit,
    page,
    extensions: 'all',
  });

  if (flags.json) {
    console.log(JSON.stringify({ ...json, pois: normalizePois(json.pois) }, null, 2));
    return;
  }
  printHumanPoiList(`POI search: ${keywords}`, json);
}

async function cmdAround(flags) {
  const key = getKey();
  const lat = flags.lat, lng = flags.lng;
  if (!lat || !lng) usage(2, 'amap around: require --lat and --lng');

  const limit = clampInt(flags.limit, 10, 1, 25);
  const page = clampInt(flags.page, 1, 1, 100);
  const radius = clampInt(flags.radius, 3000, 1, 50000);

  const json = await httpGet('https://restapi.amap.com/v3/place/around', {
    key,
    location: `${lng},${lat}`,
    keywords: flags.keywords,
    radius,
    sortrule: flags.sortrule || 'distance',
    offset: limit,
    page,
    extensions: 'all',
  });

  if (flags.json) {
    console.log(JSON.stringify({ ...json, pois: normalizePois(json.pois) }, null, 2));
    return;
  }
  printHumanPoiList(`POI around: ${lng},${lat} r=${radius}m`, json);
}

async function cmdDetails(rest, flags) {
  const key = getKey();
  const id = rest.join(' ').trim();
  if (!id) usage(2, 'amap details: missing <id>');

  const json = await httpGet('https://restapi.amap.com/v3/place/detail', {
    key,
    id,
    extensions: 'all',
  });

  if (flags.json) {
    const pois = normalizePois(json.pois);
    console.log(JSON.stringify({ ...json, pois }, null, 2));
    return;
  }

  const pois = json.pois || [];
  console.log(`POI details: ${id}\nResults: ${pois.length}`);
  pois.slice(0, 5).forEach((p, i) => {
    console.log(`${i + 1}. ${p.name}`);
    console.log(`   ${p.pname || ''}${p.cityname || ''}${p.adname || ''}${p.address ? ' · ' + p.address : ''}`.trim());
    if (p.location) console.log(`   loc: ${p.location}`);
    if (p.tel) console.log(`   tel: ${p.tel}`);
    if (p.type) console.log(`   type: ${p.type}`);
    if (p.business && p.business.opentime) console.log(`   open: ${p.business.opentime}`);
  });
}

function parseLngLat(s) {
  const t = String(s || '').trim();
  const m = t.split(',').map(x => x.trim());
  if (m.length !== 2) return null;
  const lng = Number(m[0]);
  const lat = Number(m[1]);
  if (!Number.isFinite(lng) || !Number.isFinite(lat)) return null;
  return { lng, lat };
}

function formatDurationSeconds(sec) {
  sec = Number(sec);
  if (!Number.isFinite(sec)) return '';
  const m = Math.round(sec / 60);
  const h = Math.floor(m / 60);
  const mm = m % 60;
  return h ? `${h}h${mm}m` : `${mm}m`;
}

async function cmdRoute(mode, flags) {
  const key = getKey();
  const origin = parseLngLat(flags.origin);
  const dest = parseLngLat(flags.dest);
  if (!origin || !dest) usage(2, 'amap route: require --origin <lng,lat> and --dest <lng,lat>');

  if (mode === 'driving') {
    const json = await httpGet('https://restapi.amap.com/v3/direction/driving', {
      key,
      origin: `${origin.lng},${origin.lat}`,
      destination: `${dest.lng},${dest.lat}`,
      strategy: flags.strategy,
      avoidpolygons: flags.avoidpolygons,
      extensions: 'base',
    });

    if (flags.json) { console.log(JSON.stringify(json, null, 2)); return; }

    const route = json.route || {};
    const paths = route.paths || [];
    const best = paths[0];
    console.log(`Route (driving): ${origin.lng},${origin.lat} -> ${dest.lng},${dest.lat}`);
    if (!best) {
      console.log('(no route)');
      return;
    }
    console.log(`Distance: ${best.distance}m · Duration: ${formatDurationSeconds(best.duration)}`);
    const steps = (best.steps || []).slice(0, 12);
    if (steps.length) {
      console.log('\nSteps (top 12):');
      steps.forEach((s, i) => {
        const inst = (s.instruction || '').replace(/<[^>]+>/g, '').trim();
        console.log(`${i + 1}. ${inst}`);
      });
      if ((best.steps || []).length > steps.length) console.log('...');
    }
    return;
  }

  if (mode === 'walking') {
    const json = await httpGet('https://restapi.amap.com/v3/direction/walking', {
      key,
      origin: `${origin.lng},${origin.lat}`,
      destination: `${dest.lng},${dest.lat}`,
    });

    if (flags.json) { console.log(JSON.stringify(json, null, 2)); return; }

    const route = json.route || {};
    const paths = route.paths || [];
    const best = paths[0];
    console.log(`Route (walking): ${origin.lng},${origin.lat} -> ${dest.lng},${dest.lat}`);
    if (!best) {
      console.log('(no route)');
      return;
    }
    console.log(`Distance: ${best.distance}m · Duration: ${formatDurationSeconds(best.duration)}`);
    const steps = (best.steps || []).slice(0, 12);
    if (steps.length) {
      console.log('\nSteps (top 12):');
      steps.forEach((s, i) => {
        const inst = (s.instruction || '').replace(/<[^>]+>/g, '').trim();
        console.log(`${i + 1}. ${inst}`);
      });
      if ((best.steps || []).length > steps.length) console.log('...');
    }
    return;
  }

  usage(2, `amap route: unknown mode ${mode}`);
}

async function cmdGeocode(rest, flags) {
  const key = getKey();
  const address = rest.join(' ').trim();
  if (!address) usage(2, 'amap geocode: missing <address>');

  const json = await httpGet('https://restapi.amap.com/v3/geocode/geo', {
    key,
    address,
    city: flags.city,
  });

  if (flags.json) { console.log(JSON.stringify(json, null, 2)); return; }
  const geos = json.geocodes || [];
  console.log(`Geocode: ${address}\nResults: ${geos.length}`);
  geos.slice(0, 10).forEach((g, i) => {
    console.log(`${i + 1}. ${g.formatted_address}`);
    console.log(`   loc: ${g.location} · level: ${g.level} · city: ${g.city}`);
  });
}

async function cmdRegeo(flags) {
  const key = getKey();
  const lat = flags.lat, lng = flags.lng;
  if (!lat || !lng) usage(2, 'amap regeo: require --lat and --lng');

  const radius = Number(flags.radius || 1000);
  const extensions = flags.extensions || 'all';

  const json = await httpGet('https://restapi.amap.com/v3/geocode/regeo', {
    key,
    location: `${lng},${lat}`,
    radius,
    extensions,
    batch: false,
    roadlevel: 0,
  });

  if (flags.json) { console.log(JSON.stringify(json, null, 2)); return; }
  const ra = json.regeocode || {};
  console.log(`Regeo: ${lng},${lat} r=${radius}m`);
  console.log(ra.formatted_address || '(no formatted_address)');
  const pois = (ra.pois || []).slice(0, 10);
  if (pois.length) {
    console.log(`\nNearby POIs:`);
    pois.forEach((p, i) => {
      console.log(`${i + 1}. ${p.name}${p.distance ? ' · ' + p.distance + 'm' : ''}`);
      console.log(`   ${p.address || ''}`.trim());
    });
  }
}

(async function main() {
  const args = argv.slice(2);
  if (!args.length) usage(0);

  const cmd = args[0];
  const restAndFlags = args.slice(1);

  if (cmd === 'poi') {
    const flags = parseArgs(restAndFlags);
    await cmdPoi(flags._, flags);
    return;
  }

  if (cmd === 'around') {
    const flags = parseArgs(restAndFlags);
    await cmdAround(flags);
    return;
  }

  if (cmd === 'details') {
    const flags = parseArgs(restAndFlags);
    await cmdDetails(flags._, flags);
    return;
  }

  if (cmd === 'route') {
    const mode = restAndFlags[0];
    if (!mode) usage(2, 'amap route: missing <driving|walking>');
    const flags = parseArgs(restAndFlags.slice(1));
    await cmdRoute(mode, flags);
    return;
  }

  if (cmd === 'geocode') {
    const flags = parseArgs(restAndFlags);
    await cmdGeocode(flags._, flags);
    return;
  }

  if (cmd === 'regeo') {
    const flags = parseArgs(restAndFlags);
    await cmdRegeo(flags);
    return;
  }

  usage(2, `amap: unknown command: ${cmd}`);
})().catch(err => {
  console.error('amap: error');
  if (err && err.message) console.error(err.message);
  if (err && err.detail) console.error(JSON.stringify(err.detail, null, 2));
  exit(1);
});
